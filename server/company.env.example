# Configure on the Node/Render service, never in the APK or a source archive.
DATABASE_URL=
DATABASE_SSL=true
# This integration is for direct APK distribution. Keep disabled for Play builds.
AK_DISTRIBUTION=direct-apk
AK_COMMERCE_ENABLED=false
AK_COMMERCE_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AK_MERCHANT_NAME=
AK_SUPPORT_EMAIL=
AK_TERMS_URL=
AK_PRIVACY_URL=
