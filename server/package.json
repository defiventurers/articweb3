{
  "name": "artic-web3-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start-with-runtime-status.js",
    "start:testnet": "node scripts/check-env.mjs testnet && node -r dotenv/config scripts/start-with-runtime-status.js dotenv_config_path=.env.testnet",
    "start:mainnet": "node scripts/check-env.mjs mainnet && node -r dotenv/config scripts/start-with-runtime-status.js dotenv_config_path=.env.mainnet",
    "check:testnet": "node scripts/check-env.mjs testnet",
    "check:mainnet": "node scripts/check-env.mjs mainnet",
    "test:nif": "node --test tests/nine-ice-forts-online.test.js",
    "test:fwh": "node --test tests/four-wing-ice-hunt-online.test.js",
    "test:games": "node --test tests/nine-ice-forts-online.test.js tests/four-wing-ice-hunt-online.test.js",
    "index:vault": "node scripts/index-vault-events.js",
    "smoke:mainnet": "node scripts/live-mainnet-smoke.js",
    "evidence:locked-match": "node scripts/locked-match-rehearsal-evidence.js"
  },
  "dependencies": {
    "dotenv": "latest",
    "ethers": "latest",
    "pg": "latest",
    "viem": "latest",
    "ws": "latest",
    "zksync-ethers": "latest"
  }
}
