VITE_CHAIN_ENV=testnet

# Flip to true only after VITE_ETH_VAULT_ADDRESS points to a deployed testnet vault.
VITE_ENABLE_HIGH_STAKES=false
VITE_ENABLE_SESSION_KEYS=false
VITE_ENABLE_SPONSORED_TX=false

VITE_WS_URL=ws://localhost:10000
VITE_API_BASE_URL=http://localhost:3001

VITE_ABSTRACT_CHAIN_ID=11124
VITE_ABSTRACT_RPC=https://api.testnet.abs.xyz
VITE_ABSTRACT_WS=wss://api.testnet.abs.xyz/ws
VITE_ABSTRACT_EXPLORER=https://sepolia.abscan.org/
VITE_ABSTRACT_VERIFY_URL=https://api-sepolia.abscan.org/api

# Replace with deployed testnet contracts.
VITE_ETH_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GAME_VERIFIER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_ADDRESS=0xe4C7fBB0a626ed208021ccabA6Be1566905E2dFc
VITE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
