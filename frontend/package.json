{
  "name": "artic-web3-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode testnet",
    "dev:testnet": "vite --mode testnet",
    "dev:mainnet": "vite --mode mainnet",
    "check:testnet": "node scripts/check-env.mjs testnet",
    "check:mainnet": "node scripts/check-env.mjs mainnet",
    "build": "npm run build:testnet",
    "build:testnet": "npm run check:testnet && vite build --mode testnet",
    "build:mainnet": "npm run check:mainnet && vite build --mode mainnet",
    "preview": "vite preview",
    "preview:mainnet": "vite preview --mode mainnet",
    "test:ruma": "node --test unit/ruma-rules.node.test.js",
    "test:agon": "node --test unit/agon-rules.node.test.js",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/closed-beta-smoke.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "assets:audit": "node scripts/audit-assets.mjs",
    "assets:webp": "node scripts/convert-assets-to-webp.mjs",
    "test:sanguo": "vitest run --config vitest.sanguo.config.ts",
    "build:sanguo-engine": "node scripts/build-sanguo-engine.mjs",
    "check:sanguo-engine": "node scripts/build-sanguo-engine.mjs --check",
    "build:sanyou-engine": "node scripts/build-sanyou-engine.mjs",
    "check:sanyou-engine": "node scripts/build-sanyou-engine.mjs --check",
    "test:sanyou": "vitest run --config vitest.sanyou.config.ts",
    "tune:sanyou-bot": "node scripts/tune-sanyou-bot.mjs",
    "benchmark:sanyou-bot": "SANYOU_TUNE_GENERATIONS=1 SANYOU_TUNE_CANDIDATES=1 SANYOU_TUNE_GAMES=1 node scripts/tune-sanyou-bot.mjs",
    "tune:sanguo-bot": "node scripts/tune-sanguo-bot.mjs",
    "benchmark:sanguo-bot": "SANGUO_TUNE_GENERATIONS=1 SANGUO_TUNE_CANDIDATES=1 SANGUO_TUNE_GAMES=1 node scripts/tune-sanguo-bot.mjs",
    "build:sannin-engine": "node scripts/build-sannin-engine.mjs",
    "check:sannin-engine": "node scripts/build-sannin-engine.mjs --check",
    "test:sannin": "vitest run --config vitest.sannin.config.ts",
    "test:arctic": "vitest run --config vitest.arctic.config.ts",
    "test:shogi": "vitest run --config vitest.shogi.config.ts",
    "build:shogi-engine": "node scripts/build-shogi-engine.mjs",
    "check:shogi-engine": "node scripts/build-shogi-engine.mjs --check",
    "build:xiangqi-engine": "node scripts/build-xiangqi-engine.mjs",
    "check:xiangqi-engine": "node scripts/build-xiangqi-engine.mjs --check",
    "test:xiangqi": "vitest run --config vitest.xiangqi.config.ts"
  },
  "dependencies": {
    "@abstract-foundation/agw-client": "1.12.3",
    "@abstract-foundation/agw-react": "1.13.0",
    "@tanstack/react-query": "5.101.0",
    "lucide-react": "^1.34.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1",
    "viem": "2.55.19",
    "vite": "8.0.16",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^30.0.1",
    "sharp": "0.35.1",
    "vitest": "5.0.0"
  },
  "overrides": {
    "axios": "1.19.0",
    "ws": "8.21.3"
  }
}
