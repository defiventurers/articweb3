{
  "rewrites": [
    {
      "source": "/assets/heritage-arcade/board/xiangqi-arctic-board.png",
      "destination": "/assets/heritage-arcade/board/xiangqi-arctic-board-gold-palace.svg"
    },
    {
      "source": "/api/health",
      "destination": "https://articweb3.onrender.com/readyz"
    },
    {
      "source": "/api/health/live",
      "destination": "https://articweb3.onrender.com/healthz"
    }
  ],
  "headers": [
    {
      "source": "/api/health/live",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/coming-soon.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/early/game-assets-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/early/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/early/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/early/passport-launch.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/early/passport-launch.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/heritage-arcade/sanyou-piece-placement.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/heritage-arcade/xiangqi-point-placement.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|webp|png|jpg|jpeg|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/early/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://articweb3.onrender.com; font-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/health(?:/live)?$|coming-soon\\.html$|early/?$|early/index\\.html$|early/dashboard/?$|early/dashboard/(?:index\\.html|dashboard\\.(?:js|css))$|early/(?:passport-launch\\.(?:js|css)|app\\.css|mystery-golden-egg\\.svg)$|early/art/).*)",
      "has": [
        {
          "type": "host",
          "value": "antarcticgaming.co"
        }
      ],
      "destination": "/coming-soon.html",
      "permanent": false
    },
    {
      "source": "/:path((?!api/health(?:/live)?$|coming-soon\\.html$|early/?$|early/index\\.html$|early/dashboard/?$|early/dashboard/(?:index\\.html|dashboard\\.(?:js|css))$|early/(?:passport-launch\\.(?:js|css)|app\\.css|mystery-golden-egg\\.svg)$|early/art/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.antarcticgaming.co"
        }
      ],
      "destination": "/coming-soon.html",
      "permanent": false
    },
    {
      "source": "/early",
      "destination": "/early/",
      "permanent": false
    },
    {
      "source": "/early/dashboard",
      "destination": "/early/dashboard/",
      "permanent": false
    }
  ]
}
