VITE_CHAIN_ENV=mainnet

# Keep High Stakes disabled until the mainnet escrow is deployed, verified, and tested.
VITE_ENABLE_HIGH_STAKES=false
VITE_ENABLE_SESSION_KEYS=false
VITE_ENABLE_SPONSORED_TX=false

VITE_WS_URL=wss://api.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com

VITE_ABSTRACT_CHAIN_ID=2741
VITE_ABSTRACT_RPC=https://api.mainnet.abs.xyz
VITE_ABSTRACT_WS=wss://api.mainnet.abs.xyz/ws
VITE_ABSTRACT_EXPLORER=https://abscan.org/
VITE_ABSTRACT_VERIFY_URL=https://api.abscan.org/api

# Replace with verified mainnet contracts before enabling High Stakes.
VITE_ETH_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GAME_VERIFIER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
